# Settings for scripts/tizen-setup.sh and scripts/tizen-deploy.sh.
# tizen-setup.sh copies this to .env (git-ignored) and fills it in.
TIZEN_STUDIO=$HOME/tizen-studio
TV_IP=
TV_MODEL=
TV_DUID=
TV_SDB_PORT=26101
# Signing profile. Leave as easyplex unless you made a Samsung certificate profile.
TIZEN_SIGN_PROFILE=easyplex
TIZEN_CERT_PASSWORD=
